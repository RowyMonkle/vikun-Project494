# Vikunja Docker environment variables

# PostgreSQL database connection
POSTGRES_USER=vikunja
POSTGRES_PASSWORD=vikunPassword
POSTGRES_DB=vikunja
POSTGRES_HOST=postgres

# Vikunja application settings
VIKUNJA_SERVICE_PUBLICURL=http://localhost/
VIKUNJA_FILE_STORAGE_TYPE=local
VIKUNJA_FILE_STORAGE_PATH=/app/vikunja/files
VIKUNJA_SECRET=generate_some_random_text_here_for_security
VIKUNJA_CACHE_ENABLED=1